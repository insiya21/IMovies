# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Replace placeholder with your local or MongoDB Atlas URI)
# Example local: mongodb://localhost:27017/imovies
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/imovies

# JWT Secret Key (Generate a random string for production)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Client URL for CORS
CLIENT_URL=http://localhost:5173
